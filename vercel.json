{
  "version": 2,
  "builds": [{"src": "api/index.py", "use": "@vercel/python",
              "config": {"includeFiles": ["frontend/**",
                                          "data/precomputed/**",
                                          "backend/app/static_api.py"]}}],
  "routes": [{"src": "/(.*)", "dest": "api/index.py"}]
}
